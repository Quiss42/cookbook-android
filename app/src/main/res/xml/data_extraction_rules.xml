<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is copied by cloud backups or device-to-device transfers: the login is
     encrypted with a key that only exists on this phone, and the offline copy can
     be downloaded again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
