<?xml version="1.0" encoding="utf-8"?>
<!-- Trust system CAs and user-installed CAs, so servers using a private CA
     work after installing that CA on the phone (safer than ignoring errors). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
